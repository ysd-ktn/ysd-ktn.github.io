---
// /writing/ — 記事一覧
//
// モック: _mockups/writing-index.html
//
// 移行済みの記事 (自サイトの個別ページへ) と未移行の記事 (note へ直リンク)
// を同じグリッドに混ぜて出す。 カードフッタ左のラベルで見分けられる。
//
// タグ絞り込みは ?tag=AI をクライアント側で処理する。
// 静的サイトなので /writing/tag/<tag>/ を生成する手もあるが、
//   - 記事数が少ないうちはページを増やすほどの価値がない
//   - 記事ページのタグから ?tag= 付きで飛べればリンク可能性は保てる
// の2点からクエリ方式にしている。

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Cursor from '../../components/Cursor.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { requireEntry } from '../../lib/content';
import { getArticles, TAGS } from '../../lib/writing';

const articles = await getArticles();
const profile = await requireEntry('profile', 'main');
---

<Layout
  title="WRITING — WATAOKA KOTONE"
  description={profile.writingDescription}
>
  <Cursor />
  <Header current="writing" />

  <main>
    <div class="page-head">
      <div class="crumb">
        <a href="/">INDEX</a>
        <span class="sep">/</span>
        <span class="here">WRITING</span>
      </div>
      <h1 class="page-title">WRITING<span class="dot">.</span></h1>
      <!-- 文言は src/content/profile.json の writingLede で編集する。
           配列の1要素が1行になる。
           検索結果に出る説明文は別物 (writingDescription)。 -->
      <p class="page-lede">
        {profile.writingLede.map((line, i) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </p>
    </div>

    <div class="list-bar">
      <div class="count">
        ARCHIVE · <b>{String(articles.length).padStart(2, '0')}</b> ENTRIES · SORTED BY DATE ↓
      </div>
      <div class="filters" id="filters">
        <button type="button" data-tag="" class="is-active">[ ALL ]</button>
        {TAGS.map((t) => <button type="button" data-tag={t}>{t}</button>)}
      </div>
    </div>

    <div class="writing-grid" id="grid">
      {articles.map((a, i) => <ArticleCard article={a} index={i + 1} />)}
    </div>

    <p class="empty" id="empty" hidden>該当する記事がありません。</p>

    <a
      href={profile.noteProfileUrl}
      class="list-foot"
      target="_blank"
      rel="noopener"
    >
      <span>ALSO PUBLISHING ON NOTE</span>
      <span><span class="cta-text">NOTE PROFILE </span><span class="arrow">↗</span></span>
    </a>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== ページヘッダ =====
     独立ページなので「今どこにいるか」を最初に明示する。
     breadcrumb → 巨大タイトル → 説明文 の3段構え。 */
  .page-head {
    padding: 8px 0 40px;
  }
  .crumb {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--dim);
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 28px;
  }
  .crumb a {
    color: var(--dim);
  }
  .crumb a:hover {
    color: var(--accent);
  }
  .crumb .sep {
    color: var(--line);
  }
  .crumb .here {
    color: var(--accent);
    font-weight: 700;
  }

  .page-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(48px, 11vw, 120px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  .page-title .dot {
    color: var(--accent);
  }

  .page-lede {
    max-width: 560px;
    font-family: var(--font-jp);
    font-size: 13px;
    line-height: 1.9;
    color: var(--dim);
  }

  /* ===== 件数 + タグフィルタ ===== */
  .list-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 14px 0;
    margin-bottom: 32px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--dim);
  }
  .list-bar .count b {
    color: var(--accent);
    font-weight: 700;
  }
  .filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .filters button {
    padding: 5px 12px;
    border: 1px solid var(--line);
    background: none;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
  .filters button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .filters button.is-active {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(0, 240, 189, 0.06);
    font-weight: 700;
  }

  /* ===== カードグリッド =====
     区切り線はカード側の outline が描く (ArticleCard.astro のコメント参照)。
     ここに background: var(--line) を敷くと、 タグで絞って表示枚数が
     3 未満になったときに空セルが --line 色の塊として残ってしまう。 */
  .writing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border: 1px solid var(--line);
  }
  /* 絞り込みで 0 件になったら枠ごと畳む */
  .writing-grid:has(> :not([hidden])) ~ .empty {
    display: none;
  }

  .empty {
    padding: 48px 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--dim);
  }

  /* ===== 末尾 CTA ===== */
  .list-foot {
    margin-top: 24px;
    padding: 18px 24px;
    border: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--fg);
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .list-foot:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--bg-alt);
  }
  .list-foot .arrow {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .writing-grid {
      grid-template-columns: 1fr;
    }
    .list-bar {
      font-size: 9px;
    }
    .list-foot {
      padding: 14px 16px;
    }
    .list-foot .cta-text {
      display: none;
    }
  }
</style>

<script>
  // ── タグ絞り込み ──────────────────────────────
  // URL の ?tag= を初期状態として読み、 ボタン操作では
  // history.replaceState で URL だけ差し替える (再読み込みしない)。
  // これで「AI で絞った一覧」をそのまま共有できる。

  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#filters button')];
  const cards = [...document.querySelectorAll<HTMLElement>('#grid > *')];
  const empty = document.getElementById('empty')!;

  function apply(tag: string) {
    let shown = 0;
    for (const card of cards) {
      const tags = (card.dataset.tags ?? '').split(',');
      const hit = !tag || tags.includes(tag);
      card.hidden = !hit;
      if (hit) shown++;
    }
    empty.hidden = shown > 0;
    buttons.forEach((b) => b.classList.toggle('is-active', (b.dataset.tag ?? '') === tag));
  }

  const initial = new URLSearchParams(location.search).get('tag') ?? '';
  // 知らないタグが来ても全件表示に落とす
  apply(buttons.some((b) => b.dataset.tag === initial) ? initial : '');

  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? '';
      apply(tag);
      const url = new URL(location.href);
      if (tag) url.searchParams.set('tag', tag);
      else url.searchParams.delete('tag');
      history.replaceState(null, '', url);
    });
  }
</script>
