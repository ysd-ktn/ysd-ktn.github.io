---
// LATEST — トップページに置く最新3件のティザー。
//
// かつては「WRITING」という名前で、 ナビの遷移先も兼ねていた。
// /writing/ (一覧ページ) を作った時点で名前が衝突するため LATEST に改名。
// 役割の違いは以下:
//   LATEST  — トップページ内の見せ場。 最新3件だけを出す
//   WRITING — 全記事の書庫。 ナビの WRITING はこちらへ直行する
//
// 表示する3件はコレクションの日付降順から自動で拾う。
// 以前は featured フラグをちょうど3件立てる運用だったが、 記事を足すたびに
// 古い記事のフラグを下ろす手作業が要り、 忘れると Zod で落ちるだけだった。
// 自動化して廃止。

import ArticleCard from './ArticleCard.astro';
import { getArticles } from '../lib/writing';

interface Props {
  /** セクション番号 (例: "02") */
  index?: string;
}

const { index = '02' } = Astro.props;

const all = await getArticles();
const latest = all.slice(0, 3);
const moreCount = Math.max(0, all.length - latest.length);
---

<section id="latest">
  <div class="sec-head">
    <div class="num">[ {index} ]</div>
    <!-- 表示ラベルは WRITING。 内部の id は #latest のまま。
         ナビの WRITING は /writing/ (書庫) へ直行し、このセクションを
         スクロール先に取らないので、同じ語を出しても行き先は衝突しない。
         2番目の span で LATEST と明示して、ここが最新3件の抜粋であり
         全記事ではないことを伝える。 -->
    <div class="meta">
      <span>WRITING</span>
      <span>{`LATEST ${latest.length} OF ${all.length}`}</span>
      <span>SELECTED</span>
    </div>
  </div>

  <div class="writing-grid">
    {latest.map((a, i) => <ArticleCard article={a} index={i + 1} />)}
  </div>

  <a href="/writing/" class="writing-more">
    <span>
      VIEW ALL ARTICLES{moreCount > 0 && <> · <span class="count">+{moreCount}</span> MORE</>}
    </span>
    <span class="cta"
      ><span class="cta-text">WRITING </span><span class="arrow">→</span></span
    >
  </a>
</section>

<style>
  /* 3カードグリッド。 区切り線はカード側の outline が描く
     (ArticleCard.astro のコメント参照)。 */
  .writing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border: 1px solid var(--line);
  }

  /* ===== VIEW ALL ARTICLES CTA ===== */
  .writing-more {
    margin-top: 24px;
    padding: 18px 24px;
    border: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--fg);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .writing-more:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--bg-alt);
  }
  .writing-more .count {
    color: var(--accent);
    font-weight: 700;
  }
  .writing-more .cta {
    display: flex;
    gap: 4px;
    align-items: center;
  }
  .writing-more .cta .arrow {
    color: var(--accent);
  }

  /* ===== モバイル (~720px) =====
     3カラム → 1カラム。 720px だと 1カラムあたり ≈220px しか取れず、
     16:9 サムネと title / excerpt が同居するには窮屈なため縦に積む。

     CTA は左右 2 span の space-between なので、 326px 幅では両方が
     折り返してガタつく。 右の cta からテキストだけ抜いて矢印を残す。 */
  @media (max-width: 720px) {
    .writing-grid {
      grid-template-columns: 1fr;
    }
    .writing-more {
      padding: 14px 16px;
    }
    .writing-more .cta-text {
      display: none;
    }
  }
</style>
