---
// About — PROFILE (spec シート) + TIMELINE (経歴 + 展覧会)
//
// Phase 5: src/content/profile.json (PROFILE 用) と
// src/content/timeline.json (TIMELINE 用) からデータ読込。
// props は override 用に残してある。
//
// SpecEntry: dl/dt/dd の key/value 1組
// TimelineEntry: 単発イベント (date + tag) と期間付き (from/to + role) の両方に対応

import { getCollection } from 'astro:content';
import { requireEntry } from '../lib/content';

const profile = await requireEntry('profile', 'main');

// timeline は order 降順 (大きい数値ほど上=新しい)
const timelineFromCollection = (await getCollection('timeline'))
  .map((e) => e.data)
  .sort((a, b) => b.order - a.order);

interface SpecEntry {
  key: string;
  value: string;
}

interface TimelineEntry {
  /** Content Collection の id */
  id?: string;
  /** 単発イベント (展覧会等) の日付 */
  date?: string;
  /** 期間: 開始 */
  from?: string;
  /** 期間: 終了 ("PRESENT" を含めるとアクセント色化) */
  to?: string;
  /** バッジ表示 ("EXHIBITION" 等) */
  tag?: string;
  /** タイトル (太字部分) */
  title: string;
  /** 詳細 (単発イベント用、例: "主催 — 大阪") */
  detail?: string;
  /** 役職 (期間エントリ用、例: "UI Designer") */
  role?: string;
  /** 外部リンク URL (例: 展覧会サイト) */
  url?: string;
  /** トグル詳細: 本文テキスト */
  description?: string;
  /** トグル詳細: リンク一覧 */
  links?: { label: string; url: string }[];
  /** 表示順序 (collection 由来。表示自体には不要だが型整合のため許容) */
  order?: number;
}

interface Props {
  /** セクション番号 (例: "01") */
  index?: string;
  /** sec-head の meta 行 */
  meta?: string[];
  /** PROFILE のスペックシート */
  spec?: SpecEntry[];
  /** TIMELINE の行 */
  timeline?: TimelineEntry[];
}

// profile.json から spec シート 7行を組み立てる。
// 並び順は DESIGN_SPEC の PROFILE モックに合わせて固定 (NAME → ROLE → ... → STATUS)。
const specFromProfile: SpecEntry[] = [
  { key: 'NAME', value: `${profile.nameFirst} ${profile.nameLast} / ${profile.nameJp}` },
  { key: 'LOCATION', value: `${profile.locationJp} / ${profile.locationEn} (UTC${profile.utc})` },
  { key: 'FOCUS', value: profile.focus.join(' · ') },
  { key: 'TOOLS', value: profile.tools.join(' · ') },
  { key: 'WRITING', value: profile.writingIntro },
];

const {
  index = '01',
  meta = ['ABOUT', 'PROFILE + TIMELINE + EVENTS', 'v.2026'],
  spec = specFromProfile,
  timeline = timelineFromCollection,
} = Astro.props;

// tag なし → キャリア/学歴タイムライン、tag あり → イベント・展覧会セクション
const careerTimeline = timeline.filter((e) => !e.tag);
const eventsTimeline = timeline.filter((e) => e.tag);
---

<section id="about">
  <div class="sec-head">
    <div class="num">[ {index} ]</div>
    <div class="meta">
      {meta.map((m) => <span>{m}</span>)}
    </div>
  </div>

  <div class="sub-head">[ {index}.1 / PROFILE ]</div>
  <dl class="spec">
    {
      spec.map((entry) => (
        <Fragment>
          <dt>{entry.key}</dt>
          <dd>{entry.value}</dd>
        </Fragment>
      ))
    }
  </dl>

  <div class="sub-head">[ {index}.2 / TIMELINE ]</div>
  <table class="timeline">
    <tbody>
      {
        careerTimeline.map((row, i) => {
          const hasDetail = !!(row.description || (row.links && row.links.length > 0));
          const detailId = `tl-detail-${row.id ?? i}`;
          return (
            <Fragment>
              <tr class:list={[{ 'has-detail': hasDetail }]} data-cursor-chip={hasDetail ? 'DETAILS' : undefined}>
                <td class="date">
                  <div class="date-row">
                    {hasDetail ? (
                      <button
                        class="tl-toggle"
                        aria-expanded="false"
                        aria-controls={detailId}
                      >
                        <span class="tl-toggle-icon" aria-hidden="true">&gt;</span>
                      </button>
                    ) : (
                      <span class="date-indent" aria-hidden="true"></span>
                    )}
                    <span class="date-inner">
                      {row.date ? (
                        row.date
                      ) : (
                        <Fragment>
                          {row.from} — {row.to === 'PRESENT' ? <span class="now">PRESENT</span> : row.to}
                        </Fragment>
                      )}
                    </span>
                  </div>
                </td>
                <td class="title">
                  <div class="title-wrap">
                    <span class="title-text">
                      <strong>{row.title}</strong>
                      {row.detail && <Fragment> {row.detail}</Fragment>}
                      {row.role && <Fragment> — {row.role}</Fragment>}
                    </span>
                  </div>
                </td>
              </tr>
              {hasDetail && (
                <tr class="timeline-detail" id={detailId}>
                  <td colspan={2}>
                    <div class="detail-body">
                      {row.description && <p class="detail-text">{row.description}</p>}
                      {row.links && row.links.length > 0 && (
                        <div class="detail-links">
                          {row.links.map((link) => (
                            <a
                              href={link.url}
                              target="_blank"
                              rel="noopener"
                              class="detail-link"
                            >
                              {link.label} <span aria-hidden="true">↗</span>
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </td>
                </tr>
              )}
            </Fragment>
          );
        })
      }
    </tbody>
  </table>

  {eventsTimeline.length > 0 && (
    <Fragment>
      <div class="sub-head">[ {index}.3 / EVENTS ]</div>
      <table class="timeline">
        <tbody>
          {
            eventsTimeline.map((row) => (
              <tr>
                <td class="date">
                  {row.date ? (
                    row.date
                  ) : (
                    <Fragment>
                      {row.from} — {row.to === 'PRESENT' ? <span class="now">PRESENT</span> : row.to}
                    </Fragment>
                  )}
                </td>
                <td class="title">
                  {row.tag && <span class="tag">{row.tag}</span>}
                  <strong>
                    {row.url ? (
                      <a href={row.url} target="_blank" rel="noopener" class="title-link">{row.title}</a>
                    ) : (
                      row.title
                    )}
                  </strong>
                  {row.detail && <Fragment> {row.detail}</Fragment>}
                  {row.role && <Fragment> — {row.role}</Fragment>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </Fragment>
  )}
</section>

<style>
  /* sub-head: PROFILE / TIMELINE のセクション内見出し */
  .sub-head {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--accent);
  }
  /* spec シートの直後に来る sub-head は上に余白を取る (PROFILE と TIMELINE の間) */
  .spec + .sub-head,
  .timeline + .sub-head {
    margin-top: 56px;
  }

  /* PROFILE — dl/dt/dd の spec シート */
  .spec {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 0;
  }
  .spec dt {
    padding: 14px 0;
    border-bottom: 1px dashed var(--line);
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .spec dd {
    padding: 14px 0;
    border-bottom: 1px dashed var(--line);
    font-size: 15px;
  }
  .spec dt::before {
    content: '[';
    color: var(--accent);
    margin-right: 4px;
  }
  .spec dt::after {
    content: ']';
    color: var(--accent);
    margin-left: 4px;
  }
  /* TIMELINE — テーブル */
  .timeline {
    width: 100%;
    border-collapse: collapse;
  }
  .timeline tr {
    border-bottom: 1px dashed var(--line);
  }
  .timeline td {
    padding: 14px 0;
    vertical-align: top;
  }
  .timeline .date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
    letter-spacing: 0.05em;
    width: 200px;
  }
  /* date セル内のラッパー。td 自体を flex 化すると table-cell の
     レイアウト (列幅・vertical-align) が壊れるので、必ず内側の div で受ける。 */
  .timeline .date-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  /* 展開できない行のインデント調整。▶ と同じ幅を確保して、
     全行の日付テキストの左端を揃える (ガタつき防止)。 */
  .timeline .date-indent {
    width: 10px;
    flex-shrink: 0;
  }
  .timeline .date-inner::before {
    content: '[';
    color: var(--accent);
    margin-right: 4px;
  }
  .timeline .date-inner::after {
    content: ']';
    color: var(--accent);
    margin-left: 4px;
  }
  .timeline .title {
    font-size: 15px;
  }
  .timeline .title strong {
    font-weight: 600;
  }
  .timeline .now {
    color: var(--accent);
  }
  .timeline .title-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--dim);
    transition: color 0.15s, border-color 0.15s;
  }
  .timeline .title-link::after {
    content: ' ↗';
    font-size: 0.8em;
    color: var(--accent);
  }
  .timeline .title-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .timeline .tag {
    display: inline-block;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 2px 8px;
    margin-right: 12px;
    vertical-align: middle;
  }

  /* ===== TIMELINE トグル ===== */
  /* タイトル行: テキストを flex で左寄せ、ボタンを右端に */
  .title-wrap {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .title-text {
    flex: 1;
  }

  /* > トグルインジケーター。
     記号は Hero の役職行 (.hero .role::before) と同じ `>` を使い、
     サイト全体のモノスペース + ブラケットの世界観に揃える。
     開閉は文字の差し替えではなく CSS の 90deg 回転で表現する
     (トランジションが効く / JS は aria-expanded の更新だけで済む)。
     絶対配置で親の padding 外に吊るすとモバイル (main の左 padding 16px) で
     画面外に切れるため、フロー内に置いて .date-indent と幅を揃える。 */
  .tl-toggle {
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    cursor: pointer;
    width: 10px;
    flex-shrink: 0;
    text-align: left;
    transition: opacity 0.15s;
  }
  .tl-toggle:hover {
    opacity: 0.7;
  }
  /* `>` の回転。span 側にかけるのは、button に transform を当てると
     モバイルの translateY(-50%) センタリングと競合するため。 */
  .tl-toggle-icon {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .tl-toggle[aria-expanded='true'] .tl-toggle-icon {
    transform: rotate(90deg);
  }
  /* 行全体ホバー: border-bottom が点線→実線+アクセント色に変化 */
  .timeline tr.has-detail {
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .timeline tr.has-detail:hover {
    border-bottom-color: var(--accent);
    border-bottom-style: solid;
  }

  /* 詳細行: デフォルトは非表示 */
  .timeline-detail {
    display: none;
  }
  .timeline-detail.is-open {
    display: table-row;
  }
  .timeline-detail > td {
    padding-top: 0;
    padding-bottom: 20px;
  }

  /* 詳細本体 */
  .detail-body {
    border-top: 1px dashed var(--line);
    padding-top: 12px;
  }
  .detail-text {
    font-size: 13px;
    color: var(--dim);
    line-height: 1.8;
    margin: 0 0 10px;
  }
  .detail-text:last-child {
    margin-bottom: 0;
  }
  .detail-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .detail-link {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
    transition: opacity 0.15s;
  }
  .detail-link:hover {
    opacity: 0.7;
  }

  /* ===== モバイル (~720px) =====
     PROFILE: dt 200px + dd 1fr の grid だと、 326px 画面で値の領域が
     126px しか取れず読み辛い + 長いトークン (例: "yosida.kotone@gmail.com" 等)
     は grid item の min-width:auto = min-content により親 grid を突き破って
     横スクロール余白を生む。 1カラム縦積みに切替。

     TIMELINE: table 構造のまま td を block 化。 date を 1行目、 title を
     2行目に積む。 width:240px の固定列も解除。 cell border は tr 側で扱う。 */
  @media (max-width: 720px) {
    .spec {
      grid-template-columns: 1fr;
    }
    .spec dt {
      padding: 14px 0 4px;
      border-bottom: 0;
    }
    .spec dd {
      padding: 0 0 14px;
      font-size: 14px;
      border-bottom: 1px dashed var(--line);
      overflow-wrap: anywhere;
    }
    /* table を捨てて block 縦積みに */
    .timeline,
    .timeline tbody,
    .timeline tr,
    .timeline td {
      display: block;
      width: 100%;
    }
    /* モバイルでは date / title が 2 行に積まれるため、▶ を date 行内に
       置くと「日付に付いたアイコン」に見えてドロワーだと気づきにくい。
       行全体に左 padding を空け、▶ をその gutter に絶対配置して
       ブロック全体に対して垂直中央に置く。padding は内側に確保するので
       デスクトップの負 margin 案と違い画面外にはみ出さない。 */
    .timeline tr {
      position: relative;
      padding: 12px 0 12px 18px;
      border-bottom: 1px dashed var(--line);
    }
    .timeline td {
      padding: 0;
    }
    .timeline .date {
      width: auto;
      margin-bottom: 4px;
    }
    .timeline .tl-toggle {
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
    }
    /* 全行に padding-left が付くので、フロー内スペーサーは不要 */
    .timeline .date-indent {
      display: none;
    }
    .timeline .title {
      font-size: 14px;
      overflow-wrap: anywhere;
    }
    /* モバイル: 詳細行の表示制御
       .timeline tr { display: block } の specificity (0,1,1) が
       .timeline-detail { display: none } の (0,1,0) に勝ってしまい、
       閉じた詳細行がモバイルで見えてしまう問題の修正。
       .timeline tr.timeline-detail (0,2,1) で確実に上書きする。 */
    .timeline tr.timeline-detail {
      display: none;
      padding: 0;
      border-bottom: 0;
    }
    .timeline tr.timeline-detail.is-open {
      display: block;
      /* 親行と同じ左 padding で本文の頭を揃える */
      padding: 0 0 16px 18px;
      border-bottom: 1px dashed var(--line);
    }
    .timeline-detail > td {
      padding: 0;
    }
  }
</style>

<script>
  // TIMELINE トグル: 行全体クリックで詳細を開閉する
  // ボタンクリックは tr まで bubble するので、リスナーは tr 側だけでよい
  document.querySelectorAll<HTMLTableRowElement>('.timeline tr.has-detail').forEach((row) => {
    row.addEventListener('click', () => {
      const btn = row.querySelector<HTMLButtonElement>('.tl-toggle');
      if (!btn) return;
      const targetId = btn.getAttribute('aria-controls');
      if (!targetId) return;
      const detail = document.getElementById(targetId);
      if (!detail) return;
      const isOpen = detail.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(isOpen));
      // アイコンの向きは CSS (aria-expanded="true" で 90deg 回転) に任せる
    });
  });
</script>
